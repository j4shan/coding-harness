#!/usr/bin/env bash
# Locate the draw.io desktop binary and forward every argument to it.
#
# The draw.io CLI is the same executable as the desktop app, installed at a
# different path on each platform and rarely on PATH. Resolving it is plumbing
# that every figure would otherwise redo, so it lives here once.
#
# Usage — identical to the draw.io CLI itself:
#     drawio -x -f xml --layout verticalFlow -o fig.drawio fig.drawio
#     drawio -x -f png -e -b 10 -o fig.png fig.drawio
#
# Plus one preflight mode of its own:
#     drawio --check     report the resolved binary and version, or how to install
#
# Set DRAWIO_CMD to override detection with an explicit path.
# Exits 127 with an actionable message when the app is not installed.

set -euo pipefail

find_drawio() {
    # An explicit override is authoritative: report it broken rather than
    # silently falling back to some other install the caller did not ask for.
    if [ -n "${DRAWIO_CMD:-}" ]; then
        if [ -x "$DRAWIO_CMD" ]; then
            printf '%s' "$DRAWIO_CMD"
            return 0
        fi
        echo "DRAWIO_CMD is set to '$DRAWIO_CMD', which is not executable." >&2
        return 1
    fi

    local candidate
    for candidate in drawio draw.io; do
        if command -v "$candidate" >/dev/null 2>&1; then
            command -v "$candidate"
            return 0
        fi
    done

    # WSL2 reaches the Windows install across /mnt/c.
    if grep -qiE 'microsoft|WSL' /proc/version 2>/dev/null; then
        for candidate in \
            "/mnt/c/Program Files/draw.io/draw.io.exe" \
            "/mnt/c/Users/${WIN_USER:-$USER}/AppData/Local/Programs/draw.io/draw.io.exe"; do
            [ -x "$candidate" ] && { printf '%s' "$candidate"; return 0; }
        done
    fi

    for candidate in \
        "/Applications/draw.io.app/Contents/MacOS/draw.io" \
        "$HOME/Applications/draw.io.app/Contents/MacOS/draw.io" \
        "/opt/drawio/drawio" \
        "/snap/bin/drawio" \
        "/c/Program Files/draw.io/draw.io.exe"; do
        [ -x "$candidate" ] && { printf '%s' "$candidate"; return 0; }
    done

    return 1
}

if ! DRAWIO="$(find_drawio)"; then
    cat >&2 <<'MSG'
draw.io desktop not found.

Install it to enable layout and export:
  macOS    brew install --cask drawio
  Linux    sudo snap install drawio
  Windows  winget install JGraph.Draw
  any      https://github.com/jgraph/drawio-desktop/releases

Or set DRAWIO_CMD to the executable path.

Without it you can still author and deliver a .drawio file — it opens in the
desktop app or at app.diagrams.net — but you cannot auto-layout or export.
MSG
    exit 127
fi

# Preflight: answer "can I render at all?" without drawing anything.
if [ "${1:-}" = "--check" ]; then
    printf 'draw.io found: %s\n' "$DRAWIO"
    printf 'version: %s\n' "$("$DRAWIO" --version 2>/dev/null | tail -1)"
    exit 0
fi

# Electron needs a display. On a headless Linux box, borrow a virtual one.
if [ "$(uname -s)" = "Linux" ] && [ -z "${DISPLAY:-}" ] && command -v xvfb-run >/dev/null 2>&1; then
    exec xvfb-run -a "$DRAWIO" --no-sandbox "$@"
fi

exec "$DRAWIO" "$@"
